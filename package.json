    "express": "^5.1.0",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.0",
    "pdf-parse": "^2.4.5",
