
# Get a Google OAuth Client ID: https://console.cloud.google.com/apis/credentials

# Google Sign-In (required for "Continue with Google")
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Server (default in code is 3000; use a free port locally e.g. 3088)
# PORT=3088
# RESET_BASE_URL=http://localhost:3088
# NODE_ENV=development

# Email — member lifecycle, form confirmations, password reset, reminders & digests (requires all SMTP_*)
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=BodyBank <noreply@bodybank.fit>
# SMTP_PORT=587
# SMTP_SECURE=false

# PostgreSQL (required). Create a database first, e.g.: createdb bodybank
DATABASE_URL=postgresql://localhost:5432/bodybank
# Or with username/password: postgresql://username:password@localhost:5432/bodybank

# For one-time migration from SQLite: point to your existing SQLite file, then run node scripts/migrate-sqlite-to-postgres.js
# DB_PATH=data/bodybank.db

# Admin login (defaults: admin@bodybank.fit / admin123)
# ADMIN_EMAIL=admin@bodybank.fit
# ADMIN_PASS=your_admin_password
# In production you MUST set ADMIN_PASS to a strong password (default is refused).
# Optional: override recipient for daily admin nutrition digest (defaults to ADMIN_EMAIL)
# NUTRITION_ADMIN_REPORT_EMAIL=admin@bodybank.fit

# Superadmin (business overview dashboard; defaults: superadmin@bodybank.fit / superadmin123)
# SUPERADMIN_EMAIL=superadmin@bodybank.fit
# SUPERADMIN_PASS=your_superadmin_password
# In production you MUST set both; default SUPERADMIN_PASS is refused.

# Auth (production: set a long random string for JWT and share links)
# JWT_SECRET=your-long-random-secret

# Optional: base URL for superadmin "Share via link" (defaults to request host)
# PUBLIC_URL=https://your-app.onrender.com

# Optional CORS (production)
# ALLOWED_ORIGIN=https://yoursite.com

# Admin AI Assist — Claude Sonnet (recommended: Sonnet 4.5)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: model id from your Anthropic console
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: longer client reports (default 8192 — max Claude supports)
# ADMIN_AI_MAX_OUTPUT_TOKENS=8192
# Per-client lookback for auto-fetched packs (days)
# ADMIN_AI_CLIENT_LOOKBACK_DAYS=30
# Max characters injected from each assigned program PDF (token control)
# ADMIN_AI_PROGRAM_TEXT_MAX=14000

# Nutrition AI (meal photo / text → macros; uses same Anthropic Messages API as Admin AI)
# Requires a key with available credits: https://console.anthropic.com → Plans & billing
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: vision-capable model (default in code is Sonnet 4). For lower per-meal cost after you have credits, try e.g.:
# ANTHROPIC_MODEL_NUTRITION=claude-3-5-haiku-20241022
# ANTHROPIC_MODEL_NUTRITION=claude-sonnet-4-20250514

# Blood report AI + PDF (same ANTHROPIC_API_KEY; optional model override)
# ANTHROPIC_MODEL_BLOOD=claude-sonnet-4-20250514
# File uploads (blood PDFs/images, generated health PDFs). Subfolders blood-reports/ and health-reports/ are created automatically.
# UPLOADS_DIR=./uploads
# Python with ReportLab for PDF only (no AI in Python): pip install reportlab
# On Windows, if `python` is not on PATH, set the executable explicitly:
# PYTHON_PATH=C:\Python312\python.exe
# Nutrition and blood-report emails use the same SMTP block above (userEmailService.sendMail) — no separate mail config.

# Marketing AI (Sonet API)
# SONET_API_KEY=your_sonet_or_anthropic_api_key
# SONNET_API_KEY=your_sonet_or_anthropic_api_key
# Optional endpoint override (default is Anthropic messages endpoint)
# SONET_API_URL=https://api.anthropic.com/v1/messages
# SONET_MODEL=claude-sonnet-4-20250514

# Push notifications: generate with npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your_public_key
# VAPID_PRIVATE_KEY=your_private_key

# ── WhatsApp Admin Alerts (Twilio) ──────────────────────────────────
# Get credentials at https://console.twilio.com → Account Info
# Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH=your_auth_token
# ADMIN_WHATSAPP=+91XXXXXXXXXX   (your personal WhatsApp number with country code)
# Optional: secret for signed nutrition photo links used in WhatsApp media alerts
# NUTRITION_PHOTO_LINK_SECRET=your_long_random_secret
